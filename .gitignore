# Secrets (Never push API keys!)
.env
.streamlit/secrets.toml

# Heavy Video Files (We only need the extracted frames in static/hero/)
assets/*.mp4

# Python Caches & Virtual Envs
__pycache__/
*.pyc
venv/
env/

# Local Database (Streamlit Cloud is ephemeral, so a local SQLite DB won't persist anyway)
synapse.db# Secrets
